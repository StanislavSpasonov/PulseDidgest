# Telegram (user client)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# One source group to listen (pick one)
# Example: berlin_jobs or @berlin_jobs or -1001234567890
TELEGRAM_SOURCE_CHAT=your_group_username_or_chat_id

# Optional: session name/path (Telethon)
TELETHON_SESSION_NAME=pulsedidgest

# Gemini (Google Generative AI)
GEMINI_API_KEY=your_gemini_api_key
# Optional: override Gemini model (see apps/tools/list_gemini_models.py)
GEMINI_MODEL=
