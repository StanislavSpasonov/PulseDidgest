# Telegram (user client)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Optional: legacy single-chat override (dev only)
# Example: berlin_jobs or @berlin_jobs or -1001234567890
# TELEGRAM_SOURCE_CHAT=your_group_username_or_chat_id

# Optional: session path (preferred, used by bot + collector)
# Example: .sessions/pulsedidgest
TELETHON_SESSION=.sessions/pulsedidgest
# Optional: session name fallback (used when TELETHON_SESSION points to a directory)
# TELETHON_SESSION_NAME=pulsedidgest
# Legacy alias for TELETHON_SESSION
# TELETHON_SESSION_PATH=/var/lib/pulsedidgest/telethon
# Optional: separate session for collector (set UI_TELETHON_SESSION to keep bot in sync)
# COLLECTOR_TELETHON_SESSION_NAME=.sessions/pulsedidgest-collector
# Optional: override session path for bot UI
# UI_TELETHON_SESSION=.sessions/pulsedidgest

# Gemini (Google Generative AI)
GEMINI_API_KEY=your_gemini_api_key
# Optional: override Gemini model (see apps/tools/list_gemini_models.py)
GEMINI_MODEL=models/gemini-flash-latest
GEMINI_COOLDOWN_SECONDS=60

# PostgreSQL
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pulsedidgest

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_USER_ID=123456789
DEFAULT_TZ=Europe/Berlin
CONFIG_SYNC_MODE=seed_if_empty
DELIVERY_TICK_SECONDS=60
COLLECTOR_REFRESH_SECONDS=30
